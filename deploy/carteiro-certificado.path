[Unit]
Description=carteiro: vigia o certificado do Caddy

[Path]
# O diretório, não o arquivo: o Caddy troca os arquivos por rename. Para
# outro caminho, num drop-in: `PathChanged=` vazio (zera a lista) e depois
# `PathChanged=<o seu diretório>`.
PathChanged=/var/lib/caddy/.local/share/caddy/certificates/acme-v02.api.letsencrypt.org-directory/mx.exemplo.com
Unit=carteiro-certificado.service

[Install]
WantedBy=multi-user.target
